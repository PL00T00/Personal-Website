---
import { ACHIEVEMENTS } from "../data/achievements.js";
---

<div id="achievementPopup" class="achievement-popup hidden">
    <div id="popupIcon" class="popup-icon">🏆</div>

    <div>
        <p id="achievementText" class="popup-label">Achievement Unlocked!</p>

        <h4 id="popupTitle">Title</h4>
        <p id="popupDesc">Description</p>
    </div>
</div>

<!-- Pass data safely into the browser (NO module imports in JS) -->
<script is:inline define:vars={{ ACHIEVEMENTS }}>
    (() => {
        const data = ACHIEVEMENTS;

        function getUnlocked() {
            const cookie = document.cookie
                .split(";")
                .find((c) => c.trim().startsWith("unlocked_achievement="));

            if (!cookie) return [];

            try {
                return JSON.parse(decodeURIComponent(cookie.split("=")[1]));
            } catch {
                return [];
            }
        }

        function saveUnlocked(list) {
            document.cookie =
                "unlocked_achievement=" +
                encodeURIComponent(JSON.stringify(list)) +
                "; max-age=31536000; path=/; SameSite=Lax";
        }

        function showPopup(achievement) {
            const popup = document.getElementById("achievementPopup");
            const title = document.getElementById("popupTitle");
            const desc = document.getElementById("popupDesc");
            const icon = document.getElementById("popupIcon");

            if (!popup || !title || !desc || !icon) return;

            const [emoji, ...rest] = achievement.title.split(" ");

            icon.textContent = emoji || "🏆";
            title.textContent = rest.join(" ") || achievement.title;
            desc.textContent = achievement.desc;

            // FORCE SHOW (this is the only reliable way in your setup)
            popup.style.display = "flex";

            // reset state first (important for re-triggering animation)
            popup.style.opacity = "0";
            popup.style.transform = "translateY(20px)";

            requestAnimationFrame(() => {
                popup.style.opacity = "1";
                popup.style.transform = "translateY(0)";
            });

            setTimeout(() => {
                popup.style.opacity = "0";
                popup.style.transform = "translateY(20px)";

                setTimeout(() => {
                    popup.style.display = "none";
                }, 300);
            }, 3000);
        }

        function unlockAchievement(id) {
            console.log("Achievement attempt:", id);

            if (!data[id]) {
                console.warn("Unknown achievement:", id);
                return;
            }

            const unlocked = getUnlocked();

            if (unlocked.includes(id)) return;

            unlocked.push(id);
            saveUnlocked(unlocked);

            showPopup(data[id]);
        }

        window.unlockAchievement = unlockAchievement;

        console.log("Achievement tracker loaded");
    })();
</script>

<style>
    .achievement-popup {
        position: fixed;
        bottom: 20px;
        right: 20px;

        display: flex;
        gap: 12px;
        align-items: center;

        background: #111827;
        color: white;

        padding: 16px;
        border-radius: 12px;

        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);

        opacity: 0;
        transform: translateY(80px);

        transition:
            opacity 0.3s ease,
            transform 0.3s ease;

        z-index: 9999;
        pointer-events: none;
    }

    .achievement-popup.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .hidden {
        display: none;
    }

    .popup-icon {
        font-size: 2rem;
    }

    .popup-label {
        margin: 0;
        font-size: 0.75rem;
        font-weight: bold;
        color: #fbbf24;
        text-transform: uppercase;
    }

    #popupTitle {
        margin: 0;
    }

    #popupDesc {
        margin: 0;
        font-size: 0.85rem;
        color: #9ca3af;
    }
</style>
