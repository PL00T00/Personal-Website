---
import Layout from "../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

// I kept the default comments there just for ingo
---

<Layout>
	<div id="welcome" class="page">
		<div id="tour1" class="tour hidden">
			<h1>Hey reviewer!</h1>
			<br />
			<br />
			<p>
				Welcome to the Journal of Jame!<br /> I'm going to show you around,
				giving you some background to the site!<br />If you want to
				explore at your own pace, feel free to close the tour. You can
				always get this dialogue back by typing "reviewer" on the home
				page.
			</p>
			<br /><br />
			<button
				id="closeTour"
				class="tourBtn"
				onclick="document.getElementById('tour1')?.classList.add('hidden')"
				>Close Tour</button
			>
		</div>

		<h1><strong><em>Welcome to the real Journal of Jame</em></strong></h1>
		<br />
		<br />
		<h2>Who is Jame?</h2>
		<p>
			Good question! I'm Jame. If I had to describe myself in three words
			I would probably say:<br />
			<br /><strong>Chaotic<br />Nerdy<br />Indecisive</strong><br /><br
			/>
			But if Claude was to describe me they would say:<br />
			<br /><strong>Curious<br />Creative<br />Builder</strong><br /><br
			/>
			Yeah, claude is dumb. I stand by the idea that a person's interests describes
			their personality, so heres some of mine: <br /><strong>
				<br />
				Hardware<br />
				Art<br />
				Baking<br />
				Dragon Boating<br />
				Shenanigans<br />
				Running</strong
			>
		</p><br />

		<br />
		<br />
		<br />
		I'm still vey new to website development so expect this site to be buggy!<br
		/><br /><br /><br /><br /><br /><br /><br /><br />
	</div>
</Layout>

<script>
	window.addEventListener("load", () => {
		window.unlockAchievement?.("FIRST_VISIT");
	});

	function runReviewer() {
		document.getElementById("tour1")?.classList.remove("hidden");
		console.log("IT WORKS");
	}

	const reviewCode = "REVIEWER";
	let keyPresses = "";

	document.addEventListener("keydown", (e) => {
		keyPresses += e.key.toUpperCase();

		if (keyPresses.endsWith(reviewCode)) {
			runReviewer();
			window.unlockAchievement?.("REVIEWER");
		}
	});
</script>
