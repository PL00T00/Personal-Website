---
import Layout from "../../layouts/Layout.astro";
import blinky from "../../assets/blinky.jpg";
import hackpad from "../../assets/hackpad.jpg";
import counterboard from "../../assets/Counterboard.png";
import buildGuildBadge from "../../assets/Build-Guild-Badge.png";
import lopio from "../../assets/lopio.png";
import thisWebsite from "../../assets/this-website5.png";
---

<Layout>
    <div id="tour3" class="tour hidden">
        <h1>The Projects Page!</h1><br /><br />
        <p>
            This is the projects page, it's where I show off my projects.
            Projects are sorted chronologically with my oldest projects at the
            top. Each project button has a picture of the project and a title.
            pressing on the button brings you to a page with more details.<br /> Let's
            have a look at my blinky board!
        </p>
        <button
            class="tourBtn"
            onclick="window.location.href='jamesite.dino.icu/?tour=2';"
            >Back to projects</button
        >
        <button
            class="tourBtn"
            onclick="window.location.href='/projects/blinky-board/?tour=4';"
            >Blinky board!</button
        >
    </div>
    <div id="projects">
        <h1><em><strong>What I'm working on!</strong></em></h1><br /><br />

        <p>
            Here you can find some of my past, present, and future projects that
            I am working on. They are sorted chronologically with my oldest
            projects at the top and any projects I plan to start at the bottom.<br
            /><br />

            By clicking on a project you get a description of what it is, why I
            made it and the process. There is also any relevant programs or
            courses I made it with.<br /><br />

            I hope to update this page often, it was last updated on the 11th of
            June 2026
        </p><br /><br />

        <h2>Completed Projects</h2>

        <button
            id="blinkyBoardBtn"
            class="project"
            onclick="window.location.href='/projects/blinky-board/';"
        >
            <h4>555 Chaser / Blinky Board</h4>
            <br />
            <img
                src={blinky.src}
                alt="Quite possibly the worst designed pcb you've ever seen"
                class="projectImg"
                onclick="/blinky-board/"
            />
        </button>

        <button
            id="hackpadBtn"
            class="project"
            onclick="window.location.href='/projects/hackpad/';"
        >
            <h4>4 key Hackpad</h4>
            <br />
            <img
                src={hackpad.src}
                alt="An amazingly designed 4 key macropad"
                class="projectImg"
            />
        </button>

        <button
            id="resolutionHardwareBtn"
            class="project"
            onclick="window.location.href='/projects/hackpad/';"
        >
            <h4>All Resolution Hardware</h4>
            <br /><img
                src={counterboard.src}
                alt="A cool ass slide of my counter board"
                class="projectImg"
            /></button
        >
    </div>

    <button id="lopioBtn" class="project">
        <h4>Lopio logs V1</h4>
        <br />
        <img
            src={lopio.src}
            alt="The best slack bot you've ever seen"
            class="projectImg"
        />
    </button>

    <br /><br />

    <h2>Current Projects</h2>

    <button id="pwBtn" class="project">
        <h4>This Website</h4>
        <br /><img src={thisWebsite.src} class="projectImg" />
    </button>

    <button id="escapeRoomBtn" class="project">
        <h4>Web-based escape room</h4>
        <br />No img yet :(
    </button>
</Layout>

<script is:inline>
    window.addEventListener("load", () => {
        window.unlockAchievement?.("VIEW_PROJECTS");
    });

    const params = new URLSearchParams(window.location.search);

    if (params.get("tour") === "true") {
        document.getElementById("tour3")?.classList.remove("hidden");
    }
</script>
