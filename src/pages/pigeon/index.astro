---
import Layout from "../../layouts/Layout.astro";
import Pigeon from "../../assets/bpPigeon.png";
import Truth from "../../assets/governmentPork.png";
---

<Layout>
    <h1><strong><em>PIGEON!</em></strong></h1>
    <br />
    <br />
    <p>
        If you haven't noticed already, I kinda like pigeons. This is a page
        about pigeons. While you are learning about the best bird, try and find
        all 20 hidden pigeons, you'll get a very secret achievement if you do!
        <br />
        <br />
        Look, theres one right there!
    </p>
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="1"
        style="transform:scale(1.5)"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="2"
        style="top: 45px; left: 0px;"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="3"
        style="top:460px; left: 75%; transform: scale(0.5)"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="4"
        style="top:160px; left:37%; width: 500px; height: 20px; filter:contrast(10%)"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="5"
        style="border-radius:100px; top:19px; left:58.6%; transform:scale(0.35)"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="6"
        style="filter:blur(3px); top:10px;"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="7"
        style="top:989px; left:975px; width:15px"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="8"
        style="left: 50000px; transform:scale(3)"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="9"
        style="top:50000px; transform:scale(5)"
    />
    <img
        src={Pigeon.src}
        class="pigeon secretPigeon"
        data-id="10"
        style="top:515px; left: 20px; transform:scale(3)"
    />
    <img
        src={Pigeon.src}
        class="pigeon pigeonRun"
        data-id="11"
        style="left:500px; top:500px; transform:scale(1.5)"
    />
    <img
        src={Pigeon.src}
        class="pigeon nightPigeon"
        data-id="12"
        style="top: 2500px; transform:scale(4.7); left:90px;"
    />
    <img
        src={Pigeon.src}
        class="pigeon"
        data-id="13"
        style="left:5000px; transform:scale(5)"
    />
    <img
        src={Pigeon.src}
        class="pigeon paramPigeon"
        data-id="14"
        style="left:400px; top:2500px; transform:scale(4.7)"
    />
    <img
        src={Pigeon.src}
        class="pigeon lookerPigeon"
        data-id="15"
        style="left:700px; top:2500px; transform:scale(4.7);"
    />
    <img src={Pigeon.src} class="pigeon" data-id="16" style="" />
    <img src={Pigeon.src} class="pigeon" data-id="17" style="" />
    <img src={Pigeon.src} class="pigeon" data-id="18" style="" />
    <img src={Pigeon.src} class="pigeon" data-id="19" style="" />
    <img src={Pigeon.src} class="pigeon" data-id="20" style="" />
    <br /><br /><br />
    <p style="font-size:large">
        Some pigeons are easy to find, others not so much. Some only come out
        when the page is visited in certain ways.
    </p>
    <img src={Truth.src} />
    <div id="counter">Pigeons found: 0 / 20!</div>
</Layout>
<script>
    const found = new Set(
        JSON.parse(localStorage.getItem("foundPigeons") || "[]"),
    );

    const counter = document.getElementById("counter");

    function updateCounter() {
        if (!counter) return;
        counter.textContent = `Pigeons found: ${found.size} /20!`;

        if (found.size === 1) {
            window.unlockAchievement?.("ONE_PIGEON");
        }

        if (found.size === 10) {
            window.unlockAchievement?.("TEN_PIGEONS");
        }

        if (found.size === 20) {
            window.unlockAchievement?.("ALL_PIGEONS");
        }
    }

    document.querySelectorAll(".pigeon").forEach((pigeon) => {
        const id = pigeon.dataset.id;

        if (found.has(id)) {
            pigeon.classList.add("found");
        }

        pigeon.addEventListener("click", () => {
            if (found.has(id)) return;

            found.add(id);
            pigeon.classList.add("found");

            localStorage.setItem("foundPigeons", JSON.stringify([...found]));

            updateCounter();
        });
    });

    updateCounter();

    const pigeonRun = document.querySelector(".pigeonRun");
    const rect0 = pigeonRun?.getBoundingClientRect();
    let x = rect0.left;
    let y = rect0.top;

    document.addEventListener("mousemove", (e) => {
        if (!pigeonRun) return;
        const rect = pigeonRun?.getBoundingClientRect();

        const dx = rect.left - e.clientX;
        const dy = rect.top - e.clientY;

        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < 100) {
            const angle = Math.atan2(dy, dx);

            const speed = 30;

            x += Math.cos(angle) * speed;
            y += Math.sin(angle) * speed;

            x = Math.max(0, Math.min(window.innerWidth - 40, x));
            y = Math.max(0, Math.min(window.innerHeight - 40, y));

            pigeonRun.style.left = `${x}px`;
            pigeonRun.style.top = `${y}px`;
        }
    });

    if (window.matchMedia("(prefers-color-scheme: light)").matches) {
        document.querySelector(".nightPigeon")?.classList.remove("nightPigeon");
    }

    const params = new URLSearchParams(window.location.search);

    if (params.get("pigeon") === "cool") {
        document.querySelector(".paramPigeon")?.classList.remove("paramPigeon");
    }

    const lookerPigeon = document.querySelector(".lookerPigeon");

    let idleTimer = null;

    function hideLooker() {
        if (!lookerPigeon) return;
        lookerPigeon.style.opacity = "0";
        lookerPigeon.style.pointerEvents = "none";
    }

    function showLooker() {
        if (!lookerPigeon) return;
        lookerPigeon.style.opacity = "1";
        lookerPigeon.style.pointerEvents = "auto";
    }

    hideLooker();

    function resetIdle() {
        hideLooker();

        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
            showLooker();
        }, 2000);
    }

    window.addEventListener("mousemove", resetIdle);
    window.addEventListener("scroll", resetIdle);
    window.addEventListener("keydown", resetIdle);
    window.addEventListener("click", resetIdle);
</script>
